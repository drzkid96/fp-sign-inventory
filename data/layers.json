{
  "version": 1,
  "since": "2021-01-01",
  "rules": {
    "observed": "Counts, surveys and photos: every record dated 2021-01-01 or later; older or undated records are dropped.",
    "inventory": "Current agency inventories and rules: kept when the agency's last update is 2021 or later; the update date shows on every record."
  },
  "groups": [
    {
      "id": "volumes",
      "title": "Traffic volumes",
      "color": "#00574A"
    },
    {
      "id": "speeds",
      "title": "85th percentile speeds",
      "color": "#FF6622"
    },
    {
      "id": "active",
      "title": "Walk and bike counts",
      "color": "#1B795A"
    },
    {
      "id": "parking",
      "title": "Parking",
      "color": "#568CBB"
    }
  ],
  "layers": [
    {
      "id": "caltrans_aadt",
      "group": "volumes",
      "title": "State highway AADT (Caltrans)",
      "kind": "observed",
      "geom": "point",
      "source": {
        "name": "Caltrans Traffic Census, Traffic Volumes AADT",
        "agency": "Caltrans",
        "url": "https://caltrans-gis.dot.ca.gov/arcgis/rest/services/CHhighway/Traffic_AADT/FeatureServer/0",
        "license": "Public, State of California"
      },
      "fetch": {
        "type": "arcgis",
        "url": "https://caltrans-gis.dot.ca.gov/arcgis/rest/services/CHhighway/Traffic_AADT/FeatureServer/0",
        "where": "CNTY='LA'"
      },
      "date": {
        "fixed": "2023"
      },
      "map": {
        "route": "RTE",
        "pm": "PM",
        "desc": "DESCRIPTION",
        "aadt_back": "BACK_AADT",
        "aadt_ahead": "AHEAD_AADT",
        "peak_hour_back": "BACK_PEAK_HOUR",
        "peak_hour_ahead": "AHEAD_PEAK_HOUR",
        "peak_month_back": "BACK_PEAK_MADT",
        "peak_month_ahead": "AHEAD_PEAK_MADT"
      },
      "hook": "caltrans_aadt",
      "style": {
        "metric": "aadt",
        "stops": [
          [
            0,
            3
          ],
          [
            50000,
            5
          ],
          [
            300000,
            9
          ]
        ],
        "label": "{aadt_k}"
      },
      "card": {
        "title": "Route {route} at PM {pm}",
        "sub": "{desc}",
        "fields": [
          [
            "AADT, back leg",
            "aadt_back",
            "num"
          ],
          [
            "AADT, ahead leg",
            "aadt_ahead",
            "num"
          ],
          [
            "Peak hour, back / ahead",
            "peak_hour",
            "text"
          ],
          [
            "Peak month ADT, back / ahead",
            "peak_month",
            "text"
          ],
          [
            "Count year",
            "year",
            "text"
          ]
        ],
        "note": "Annual average daily traffic, both directions. Back leg is usually south or west of the point, ahead leg north or east. No weekday or weekend split is published."
      }
    },
